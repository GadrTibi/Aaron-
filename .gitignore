# --- Environnements / caches ---
.venv/
.venv_analyse/
env/
venv/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.cache/
*.DS_Store
.streamlit/

# --- Config / mémoire d'agents Claude (locale, non versionnée) ---
.claude/

# --- Build / distribution ---
build/
dist/
*.spec

# --- Logs / temporaires ---
*.log
*.tmp
*.temp
Thumbs.db
*.lock

# --- Sorties générées (recréées au runtime) ---
output/**
!output/.gitkeep
# NB : certains modules écrivent en dur sous out/ (caches places/geocode/wiki,
# images, plots) — chemins à unifier avec output/ (dette notée). En attendant,
# on n'y versionne aucun artefact généré.
out/

# --- Images téléchargées ---
app/static/images/**
!app/static/images/.gitkeep

# --- Templates (non versionnés) ---
app/templates/**

# --- Fichiers de lock Office ---
~$*
